{
  "id": "my-robot",
  "name": "My Robot",
  "version": "0.1.0",
  "author": "Your Name",
  "description": "Plugin for My Robot",
  "sdk_version": ">=0.1.0",
  "node_types": ["agv"],
  "fixed_capabilities": ["gps", "battery"],
  "optional_capabilities": ["camera", "lidar"],
  "capabilities": [
    {
      "id": "move_to",
      "label": "Move To",
      "params": ["lat", "lon", "alt"],
      "destructive": false
    },
    {
      "id": "stop",
      "label": "Stop",
      "params": [],
      "destructive": false
    },
    {
      "id": "return_home",
      "label": "Return Home",
      "params": [],
      "destructive": false
    }
  ],
  "config_schema": {
    "host": {
      "type": "string",
      "label": "Robot IP Address",
      "required": true,
      "placeholder": "192.168.1.100"
    },
    "port": {
      "type": "number",
      "label": "Rosbridge Port",
      "required": false,
      "default": 9090
    },
    "namespace": {
      "type": "string",
      "label": "ROS2 Namespace",
      "required": false,
      "default": "",
      "placeholder": "/my_robot"
    },
    "position_source": {
      "type": "select",
      "label": "Positioning Source",
      "required": true,
      "default": "gps",
      "description": "GPS: robot has onboard GPS. VICON: position from motion capture system.",
      "options": [
        { "label": "GPS (onboard)", "value": "gps" },
        { "label": "VICON (motion capture)", "value": "vicon" }
      ]
    },
    "vicon_object_name": {
      "type": "string",
      "label": "VICON Object Name",
      "required": false,
      "placeholder": "robot",
      "description": "Must exactly match the rigid body name in VICON Tracker.",
      "show_when": { "field": "position_source", "value": "vicon" }
    },
    "home_lat": {
      "type": "number",
      "label": "Arena Origin Latitude",
      "required": false,
      "placeholder": "-37.9105",
      "description": "WGS84 latitude of the VICON arena origin (X=0, Y=0).",
      "show_when": { "field": "position_source", "value": "vicon" }
    },
    "home_lon": {
      "type": "number",
      "label": "Arena Origin Longitude",
      "required": false,
      "placeholder": "145.1362",
      "description": "WGS84 longitude of the VICON arena origin (X=0, Y=0).",
      "show_when": { "field": "position_source", "value": "vicon" }
    },
    "gps_topic": {
      "type": "string",
      "label": "GPS Topic",
      "required": false,
      "placeholder": "/gps/fix",
      "description": "ROS2 topic publishing sensor_msgs/NavSatFix. Leave blank for /gps/fix.",
      "show_when": { "field": "position_source", "value": "gps" }
    }
  }
}
